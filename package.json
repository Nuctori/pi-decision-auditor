{
  "name": "pi-pair",
  "version": "1.6.0",
  "description": "结对决策审计（pair audit）：自动捕获 AI 决策推理链到 docs/decisions/chain.md，审计者随对话增量被唤起，审决策链（推理/正确性/漂移），目标推导自对话日志，按需查询主会话",
  "license": "MIT",
  "author": "Nuctori",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuctori/pi-pair.git"
  },
  "homepage": "https://github.com/Nuctori/pi-pair",
  "bugs": {
    "url": "https://github.com/Nuctori/pi-pair/issues"
  },
  "keywords": ["pi-package", "decision-audit", "pair-programming", "audit", "decision-chain"],
  "type": "module",
  "files": [
    "extensions/",
    "lib/",
    "agents/",
    "skills/",
    "prompts/",
    "test/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "tsx --test test/chain-store.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.5.0"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "subagents": {
      "agents": ["./agents"]
    }
  },
  "pi-subagents": {
    "agents": ["./agents"]
  }
}
