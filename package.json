{
  "name": "pi-decision-auditor",
  "version": "1.0.0",
  "description": "结对决策审计：捕获 AI 决策推理链到 docs/decisions/chain.md，常驻审计者只审决策链（推理有效性/完整性/链一致性/校准/正确性/忠实性），目标推导自对话日志，缺上下文时按需查询主会话",
  "license": "MIT",
  "author": "Nuctori",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuctori/pi-decision-auditor.git"
  },
  "homepage": "https://github.com/Nuctori/pi-decision-auditor",
  "bugs": {
    "url": "https://github.com/Nuctori/pi-decision-auditor/issues"
  },
  "keywords": ["pi-package", "decision-audit", "pair-programming", "audit", "decision-chain"],
  "type": "module",
  "main": "extensions/decision-chain.ts",
  "files": [
    "extensions/",
    "lib/",
    "agents/",
    "skills/",
    "prompts/",
    "test/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "tsx --test test/chain-store.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.5.0"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "subagents": {
      "agents": ["./agents"],
      "chains": ["./chains"]
    }
  },
  "pi-subagents": {
    "agents": ["./agents"],
    "chains": ["./chains"]
  }
}
